# Copy this file to .env for local preview, or set these as
# Environment Variables in the Vercel project settings.
# Find both values in Supabase: Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The address of the referee app (the separate scorack-user project),
# no trailing slash. When set, the Referee codes section shows and prints the
# full referee address for each tournament.
VITE_USER_APP_URL=https://your-referee-app.vercel.app

# The console's own public address, used in the sign-in emails and invitation
# messages sent to other people. Set it to the SHORT production address, never one
# of the long auto-generated ones (Vercel puts its own login in front of those).
VITE_CONSOLE_URL=https://your-console.vercel.app
